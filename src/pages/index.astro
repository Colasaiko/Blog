---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://bestjichang.com/#website",
      "url": "https://bestjichang.com/",
      "name": "好机场",
      "description": "整理2026机场推荐与实测数据，覆盖稳定机场、便宜机场、IPLC/IEPL专线、套餐价格、优惠码、Clash与Shadowrocket兼容性，并按线路、速度、晚高峰表现和使用场景持续更新。"
    },
    {
      "@type": "Organization",
      "@id": "https://bestjichang.com/#organization",
      "name": "好机场",
      "url": "https://bestjichang.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://bestjichang.com/favicon.svg"
      }
    }
  ]
});

const title = "2026机场推荐：稳定、便宜与专线机场评测指南";
const description = "2026最新机场推荐与评测入口。按预算与线路分类，涵盖稳定机场、便宜高性价比套餐及 IPLC/IEPL 专线，提供最适合您的科学上网机场指南。";

const allPosts = await getCollection('blog');
const priorityKeywords = ['机场', '评测', 'Clash', '线路', '节点', '稳定'];

const posts = allPosts.sort((a, b) => {
  const aTitle = a.data.title || '';
  const bTitle = b.data.title || '';
  
  const aIsPriority = priorityKeywords.some(kw => aTitle.includes(kw));
  const bIsPriority = priorityKeywords.some(kw => bTitle.includes(kw));

  // If one is priority and the other is not, the priority one comes first
  if (aIsPriority && !bIsPriority) return -1;
  if (!aIsPriority && bIsPriority) return 1;

  // Otherwise fallback to date
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const featuredPosts = posts.filter(p => p.data.featured && p.data.coverImage).slice(0, 4);

const recommendedSlugs = [
  'top-4-recommended-airports',
  'mac-clash-verge-rev',
  'review-01-weifeng',
  'review-02-feimao',
  'clash-06',
  'adv-09'
];
const recommendedPosts = recommendedSlugs.map(slug => posts.find(p => p.slug === slug)).filter(Boolean);

const rankings = [
  { rank: 1, name: '微风', audience: '日常上网、流媒体爱好者', features: '全 IPLC 专线，不限制设备接入数量', platforms: 'Win / Mac / iOS / Android', slug: 'review-01-weifeng' },
  { rank: 2, name: '飞猫', audience: '多设备重度用户', features: '最高 2.5Gbps 速率，原生 IP 解锁', platforms: '全平台及主流路由器', slug: 'review-02-feimao' },
  { rank: 3, name: 'Sogo', audience: '进阶用户、企业级需求', features: 'VLESS 协议，企业级 IEPL 专线', platforms: 'Win / Mac / iOS / Android / OpenWrt', slug: 'review-03-sogo' },
  { rank: 4, name: '暮光', audience: '追求极简的备用选择', features: 'BGP 多线智能调度，专线级出口架构', platforms: 'Win / Mac / iOS / Android', slug: 'review-04-muguang' },
];

const guidePosts = posts
  .filter(p => p.slug.startsWith('guide-'))
  .sort((a, b) => a.slug.localeCompare(b.slug))
  .slice(0, 10);

const faqs = [
    {
      q: '2026机场怎么选？',
      a: '在 2026 年选择机场，首先要明确您的核心需求。如果是刷网页查资料，几十块钱一年的平价套餐即可；如果需要打游戏、看 4K 流媒体或重度办公，推荐选择 IPLC/IEPL 专线机场。具体可参考我们的《机场选择指南》，通过对比预算、线路、设备兼容性快速挑选。'
    },
    {
      q: '机场越贵越稳定吗？',
      a: '不一定。机场稳定性主要由线路架构（如是否有 IPLC 专线）和冗余节点决定。有些高价机场由于用户过多也可能导致晚高峰拥堵。在我们的机场排行榜中，会综合评估“价格”与“实际 SLA（服务等级协议）”，帮助您找到高性价比且真正稳定的服务。'
    },
    {
      q: 'IPLC和IEPL有什么区别？',
      a: '两者都属于专线级别。IPLC（国际专线）是物理层面的端到端内网专线，延迟极低；IEPL（国际以太网专线）属于二层以太网链路，配置更灵活。在实际翻墙体验中，两者均不过墙、不丢包，都是目前最顶级的线路类型，晚高峰表现极其稳定。'
    },
    {
      q: '便宜机场靠谱吗？',
      a: '市面上有许多几块钱一个月的低价梯子，它们的特点是“高性价比、大流量”。这些便宜机场多采用公网直连或普通中转，晚高峰偶尔会有轻微卡顿。只要是口碑较好的老牌商家，对于非重度视频用户来说是非常靠谱的备用或日常选择。'
    },
    {
      q: 'Clash应该选择什么机场？',
      a: '目前绝大多数机场都完美支持 Clash（包括 Clash Verge Rev / Mihomo 内核）。选择时，推荐寻找提供“一键导入 Clash 订阅”功能的商家，这能极大地简化您的配置流程。支持自动测速和多节点智能分流的机场体验最佳。'
    },
    {
      q: 'Shadowrocket怎么选择机场？',
      a: 'Shadowrocket（小火箭）是 iOS 平台上最流行的客户端。iOS 用户在选购机场时，优先选择那些提供完整 Shadowrocket 订阅教程、扫码一键导入的机场。这会让手机端用户的设置成本降到最低。'
    },
    {
      q: '按量机场适合什么人？',
      a: '按量计费套餐（不限时流量包）非常适合两类人：一是偶尔需要科学上网查阅资料的轻度用户；二是已经购买了主力机场，只想花 10 块钱买一个备用节点的重度用户。这类套餐买了之后只要流量没用完就不会过期，性价比极高。'
    },
    {
      q: '机场线路怎么看？',
      a: '常见线路分为三类：1. 直连线路（价格最低，晚高峰易卡顿拥堵）；2. 中转线路（目前主流，通过国内服务器中转出国，速度有保障）；3. IPLC/IEPL 专线（价格最高，完全不经过防火墙，延迟最低不丢包）。'
    }
  ];

const networkTags = ['客户端下载', 'AI 工具指南', '代理规则配置', '网络优化', '隐私保护探索'];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} image="/og/og-home.jpg">

  <!-- Subtle Background Pattern -->
  <div class="absolute inset-0 z-[-1] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-100 via-white to-white dark:from-slate-900 dark:via-slate-950 dark:to-slate-950 opacity-80 h-[600px] pointer-events-none"></div>

  <div class="space-y-8 sm:space-y-12 pb-10 pt-2">
    <!-- Hero Section (Two Columns) -->
    <section id="hero" class="max-w-7xl mx-auto px-4 pt-2 pb-2 sm:pt-4 sm:pb-4 scroll-mt-24">
      <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-6">
        
        <!-- Left: Text Content -->
        <div class="flex-1 text-center lg:text-left z-10">
          <h1 class="reveal-el text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4 leading-tight">
