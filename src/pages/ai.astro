---
import SubpageNav from '../components/SubpageNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = "AI 工具教程与使用指南：ChatGPT、Claude、Grok、Gemini 实战 | 好机场";
const description = "全面涵盖 AI 工具使用技巧、AI 视频创作指南，以及 ChatGPT、Claude、Perplexity、Poe 等主流 AI 服务常见网络连接与解锁问题解决方案。";

const posts = await getCollection('blog');
const aiPosts = posts.filter(post => post.data.category.startsWith('AI') || post.slug.startsWith('ai-'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const consumedSlugs = new Set();

interface Group {
  id: string;
  name: string;
  desc: string;
  filter: (p: any) => boolean;
  posts?: any[];
}

const groups: Group[] = [
  {
    id: 'chatgpt-basics',
    name: '1. ChatGPT 基础入门',
    desc: 'ChatGPT 基础入门、提示词编写与常见功能详解',
    filter: (p: any) => p.data.title.toLowerCase().includes('chatgpt') || p.slug.includes('chatgpt')
  },
  {
    id: 'claude-advanced',
    name: '2. Claude 进阶使用',
    desc: 'Claude 及其 Artifacts 功能解析',
    filter: (p: any) => p.data.title.toLowerCase().includes('claude') || p.slug.includes('claude')
  },
  {
    id: 'gemini-ecosystem',
    name: '3. Gemini 生态接入',
    desc: 'Gemini 生态接入与多模态文件处理方法',
    filter: (p: any) => p.data.title.toLowerCase().includes('gemini') || p.slug.includes('gemini')
  },
  {
    id: 'copilot-tools',
    name: '4. Copilot 及其他官方 AI',
    desc: '微软 Copilot 等官方原生 AI 助手使用指南',
    filter: (p: any) => p.data.title.toLowerCase().includes('copilot') || p.slug.includes('copilot')
  },
  {
    id: 'ai-study',
    name: '5. AI 学习与提升（学生）',
    desc: '整理笔记、拆解复杂知识、阅读论文与语言学习辅助',
    filter: (p: any) => p.data.category === 'AI 工作与学习' && p.slug.includes('study')
  },
  {
    id: 'ai-workflow',
    name: '6. AI 进阶工作流',
    desc: '将多个 AI 工具组合，建立个人自动化工作流',
    filter: (p: any) => p.data.category === 'AI 工作与学习' && p.slug.includes('workflow')
  },
  {
    id: 'ai-video',
    name: '7. AI 视频与图片',
    desc: '从 Image to Video 到短剧制作，控制画风与人物一致性',
    filter: (p: any) => p.data.category === 'AI 视频与图片' || p.slug.includes('video') || p.slug.includes('drama') || p.slug.includes('image')
  }
];

groups.forEach(group => {
  group.posts = aiPosts.filter(p => {
    if (consumedSlugs.has(p.slug)) return false;
    if (group.filter(p)) {
      consumedSlugs.add(p.slug);
      return true;
    }
    return false;
  });
});

const remainingPosts = aiPosts.filter(p => !consumedSlugs.has(p.slug));
if (remainingPosts.length > 0) {
  groups.push({
    id: 'other-practical',
    name: '8. 其他实用 AI 技巧',
    desc: '未分类的 AI 提示词技巧与黑科技',
    filter: () => false,
    posts: remainingPosts
  });
}


const currentUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${currentUrl}#webpage`,
      "url": currentUrl,
      "name": `${title} | 好机场`,
      "description": description
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首页",
          "item": new URL("/", Astro.site).href
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": title,
          "item": currentUrl
        }
      ]
    }
  ]
});

---

<BaseLayout title={title + " | 好机场"} description={description} jsonLd={jsonLd}>
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6">
    <div class="text-center mb-16">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-6">
        AI 教程与实战指南
      </h1>
      <p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 max-w-3xl mx-auto leading-relaxed">
        {description}
      </p>
        <SubpageNav exclude="ai" />
</div>

    <nav class="sticky top-[72px] z-40 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl py-3 mb-12 border-b border-slate-200/50 dark:border-slate-800/50 -mx-4 px-4 sm:mx-0 sm:px-0 flex flex-wrap justify-center gap-2 sm:gap-3 items-center">
      {groups.map(group => {
        if (!group.posts || group.posts.length === 0) return null;
        return (
          <a href={`#${group.id}`} class="whitespace-nowrap px-4 py-2 rounded-full text-sm font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
            {group.name.replace(/^[0-9]+\.\s/, "")}
          </a>
        )
      })}
    </nav>

    <style>
      /* Hide scrollbar for Chrome, Safari and Opera */
      .hide-scrollbar::-webkit-scrollbar {
        display: none;
      }
      /* Hide scrollbar for IE, Edge and Firefox */
      .hide-scrollbar {
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
      }
    </style>

    <div class="space-y-16">
      {groups.map((group) => {
        const posts = group.posts || [];
        if (posts.length === 0) return null;
        return (
          <section id={group.id} class="scroll-mt-32">
            <div class="mb-8 border-b border-slate-200 dark:border-slate-800 pb-4">
              <div class="flex items-end justify-between">
                <div>
                  <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-2">{group.name}</h2>
                  <p class="text-slate-500 dark:text-slate-400">{group.desc}</p>
                </div>
                <span class="hidden sm:inline-block text-sm font-bold text-primary-600 bg-primary-100 dark:text-primary-400 dark:bg-primary-900/30 px-4 py-1.5 rounded-full">{posts.length} 篇内容</span>
              </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {posts.map((post: any) => (
                <a href={`/blog/${post.slug}/`} class="group block p-6 bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 rounded-2xl hover:border-primary-500 dark:hover:border-primary-500 hover:shadow-xl transition-all duration-300">
                  <h3 class="text-lg font-bold text-slate-800 dark:text-slate-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 mb-3 line-clamp-2">{post.data.title}</h3>
                  <p class="text-sm text-slate-600 dark:text-slate-400 line-clamp-3">{post.data.description}</p>
                </a>
              ))}
            </div>
          </section>
        )
      })}
    </div>
  </div>
</BaseLayout>
