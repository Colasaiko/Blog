---
import SubpageNav from '../components/SubpageNav.astro';
import TrustBadge from '../components/TrustBadge.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = "优质机场与网络加速服务商品牌介绍与完整排行榜 | 好机场";
const description = "精选优质机场与网络加速服务商品牌评测、测速、价格与套餐推荐。详细解析 IPLC/IEPL 专线及高性价比优质网络服务商特点，助您选择最佳方案。";

// Fetch posts if we still want to show brand review articles at the bottom
const posts = (await getCollection('blog'))
  .filter(post => post.data.category === '品牌介绍')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const rankings = [
  { rank: 1, name: '微风', audience: '日常上网、流媒体爱好者', features: '全 IPLC 专线，不限制设备接入数量', platforms: 'Win / Mac / iOS / Android', slug: 'review-01-weifeng' },
  { rank: 2, name: '飞猫', audience: '多设备重度用户', features: '最高 2.5Gbps 高速速率，原生 IP 解锁', platforms: '全平台及主流路由器', slug: 'review-02-feimao' },
  { rank: 3, name: 'Sogo', audience: '进阶用户、企业级需求', features: '支持 VLESS 协议，企业级 IEPL 专线', platforms: 'Win / Mac / iOS / Android / OpenWrt', slug: 'review-03-sogo' },
  { rank: 4, name: '幕光', audience: '追求极简的备用选择', features: 'BGP 多线智能调度，专线级出口架构', platforms: 'Win / Mac / iOS / Android', slug: 'review-04-muguang' },
];

const currentUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${currentUrl}#webpage`,
      "url": currentUrl,
      "name": `${title} | 好机场`,
      "description": description
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首页",
          "item": new URL("/", Astro.site).href
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "品牌图鉴",
          "item": currentUrl
        }
      ]
    }
  ]
});

const allBrands = [
  { name: '微风网络', id: 'weifeng', url: 'https://wep01.breezenetaff.com/#/?code=bSnymFll', promo: 'weifeng90 (7折)', desc: '全IPLC专线，提供低延迟高速网络，不限制设备同时接入。' },
