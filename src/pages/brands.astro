  { name: '梯子云', id: 'tizi', url: 'https://asfawsf.ladderttt.sbs/#/?code=3vf6NG2u', promo: 'tiziyun (8折)', desc: '基础中转方案+多入口智能调度，套餐内不限速，全节点1x计费倍率。' },
