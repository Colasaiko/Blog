const currentUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${currentUrl}#webpage`,
      "url": currentUrl,
      "name": "新手教程与学习路径 | 好机场",
      "description": "从零开始学习，完整带您了解网络基础、线路分类与各类网络工具的入门使用。"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首页",
          "item": new URL("/", Astro.site).href
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "新手教程与学习路径",
          "item": currentUrl
        }
      ]
    }
  ]
});

---

<BaseLayout title="网络线路与代理协议基础：新手教程与入门学习路线 | 好机场" description="从零开始的网络基础学习路线，完整带您了解 IP 地址、网络延迟、BGP、专线分类以及各类网络协议与工具的入门使用原理，助您快速掌握代理网络知识。" image="/og/og-network.jpg" jsonLd={jsonLd}>
  
  <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 pt-8">
    <div class="flex flex-col lg:flex-row gap-8 items-start mb-24">
      
      <!-- Left Sidebar Navigation Tree -->
      <aside class="hidden lg:block w-full lg:w-72 2xl:w-80 flex-shrink-0 sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto rounded-3xl transform-gpu overscroll-contain" style="scrollbar-width: none; will-change: transform, scroll-position; -webkit-overflow-scrolling: touch;">
        <div class="bg-slate-50 dark:bg-slate-900 p-6 border border-slate-200 dark:border-slate-800 min-h-full 2xl:shadow-xl 2xl:bg-white dark:2xl:bg-slate-900">
          <div class="font-black text-lg text-slate-900 dark:text-white mb-6 flex items-center">
            <svg class="w-5 h-5 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            学习路径导航
          </div>
          
          <div class="space-y-8">
            <!-- 1. 新手入门 -->
            <div>
              <a href="#section-1" class="font-bold text-slate-900 dark:text-white mb-3 text-sm tracking-wider flex items-center hover:text-primary-600 transition-colors group">
                <span class="w-6 h-6 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 flex items-center justify-center text-xs mr-2 group-hover:bg-primary-600 group-hover:text-white transition-colors">1</span>
                新手入门网络知识
              </a>
              <ul class="space-y-2.5 border-l border-slate-200 dark:border-slate-800 ml-3 pl-4">
                {beginner.slice(0, 4).map(title => (
                  <li><span class="text-sm text-slate-500 dark:text-slate-400 truncate block">{title.substring(3)}</span></li>
                ))}
                <li><a href="#section-1" class="text-xs text-primary-500 font-medium hover:underline flex items-center">查看全部 {beginner.length} 篇 <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></a></li>
              </ul>
            </div>

            <!-- 2. 进阶网络 -->
            <div>
              <a href="#section-2" class="font-bold text-slate-900 dark:text-white mb-3 text-sm tracking-wider flex items-center hover:text-emerald-600 transition-colors group">
                <span class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-900/50 text-emerald-600 flex items-center justify-center text-xs mr-2 group-hover:bg-emerald-600 group-hover:text-white transition-colors">2</span>
                进阶网络概念解析
              </a>
              <ul class="space-y-2.5 border-l border-slate-200 dark:border-slate-800 ml-3 pl-4">
                {advanced.slice(0, 4).map(title => (
                  <li><span class="text-sm text-slate-500 dark:text-slate-400 truncate block">{title.substring(3)}</span></li>
                ))}
                <li><a href="#section-2" class="text-xs text-emerald-500 font-medium hover:underline flex items-center">查看全部 {advanced.length} 篇 <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></a></li>
              </ul>
            </div>

            <!-- 3. 客户端与 Clash -->
            <div>
              <a href="#section-3" class="font-bold text-slate-900 dark:text-white mb-3 text-sm tracking-wider flex items-center hover:text-blue-600 transition-colors group">
                <span class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-600 flex items-center justify-center text-xs mr-2 group-hover:bg-blue-600 group-hover:text-white transition-colors">3</span>
                客户端与 Clash 专区
              </a>
              <ul class="space-y-2.5 border-l border-slate-200 dark:border-slate-800 ml-3 pl-4">
                {clash.slice(0, 4).map(title => (
                  <li><span class="text-sm text-slate-500 dark:text-slate-400 truncate block">{title.substring(3)}</span></li>
                ))}
                <li><a href="#section-3" class="text-xs text-blue-500 font-medium hover:underline flex items-center">查看全部 {clash.length} 篇 <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></a></li>
              </ul>
            </div>

            <!-- 4. 常用网络工具 -->
            <div>
              <a href="#section-4" class="font-bold text-slate-900 dark:text-white mb-3 text-sm tracking-wider flex items-center hover:text-purple-600 transition-colors group">
                <span class="w-6 h-6 rounded-full bg-purple-100 dark:bg-purple-900/50 text-purple-600 flex items-center justify-center text-xs mr-2 group-hover:bg-purple-600 group-hover:text-white transition-colors">4</span>
                常用网络工具
              </a>
              <ul class="space-y-2.5 border-l border-slate-200 dark:border-slate-800 ml-3 pl-4">
                {tools.slice(0, 4).map(title => (
                  <li><span class="text-sm text-slate-500 dark:text-slate-400 truncate block">{title.substring(3)}</span></li>
                ))}
                <li><a href="#section-4" class="text-xs text-purple-500 font-medium hover:underline flex items-center">查看全部 {tools.length} 篇 <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></a></li>
              </ul>
            </div>
          </div>
        </div>
      </aside>

      <!-- Right Main Content -->
      <div class="flex-1 min-w-0 w-full relative z-10">
        <div class="text-left mb-16 pt-2">
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4">
            从零开始学习
          </h1>
          <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl">
            一份写给新手的结构化指南。从网络基础概念到高阶线路原理解析，再到主流工具的使用手册。
          </p>
</div>
        <SubpageNav exclude="network" />
<div class="space-y-16">
          <!-- 新手入门 -->
          <section id="section-1" class="scroll-mt-32">
            <div class="flex items-center space-x-4 mb-8">
              <div class="w-10 h-10 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 flex items-center justify-center font-bold text-lg">1</div>
              <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">新手入门网络知识</h2>
            </div>
            <div class="bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden divide-y divide-slate-100 dark:divide-slate-800/60 shadow-sm">
              {beginner.map((title) => {
                const num = title.substring(0, 2);
                const text = title.substring(3);
                return (
                  <a href={`/blog/guide-${num}/`} class="group flex items-center p-4 sm:p-5 transition-all duration-200 ease-out hover:bg-slate-50 dark:hover:bg-slate-900 focus-visible:outline-none focus-visible:bg-slate-50 dark:focus-visible:bg-slate-900">
                    <span class="w-10 font-mono text-sm font-semibold text-slate-400 group-hover:text-primary-500 transition-colors duration-200">{num}</span>
                    <span class="flex-grow font-medium text-slate-700 dark:text-slate-200 transition-transform duration-200 ease-out group-hover:translate-x-1 group-hover:text-slate-900 dark:group-hover:text-white">{text}</span>
                    <span class="text-slate-300 dark:text-slate-700 group-hover:text-primary-500 transition-all duration-200 ease-out opacity-0 group-hover:opacity-100 group-hover:translate-x-1">&rarr;</span>
                  </a>
                );
              })}
            </div>
          </section>

          <!-- 进阶网络 -->
          <section id="section-2" class="scroll-mt-32">
            <div class="flex items-center space-x-4 mb-8">
              <div class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-900/50 text-emerald-600 flex items-center justify-center font-bold text-lg">2</div>
              <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">进阶网络概念解析</h2>
            </div>
            <div class="bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden divide-y divide-slate-100 dark:divide-slate-800/60 shadow-sm">
              {advanced.map((title) => {
                const num = title.substring(0, 2);
                const text = title.substring(3);
                return (
                  <a href={`/blog/adv-${num}/`} class="group flex items-center p-4 sm:p-5 transition-all duration-200 ease-out hover:bg-slate-50 dark:hover:bg-slate-900 focus-visible:outline-none focus-visible:bg-slate-50 dark:focus-visible:bg-slate-900">
                    <span class="w-10 font-mono text-sm font-semibold text-slate-400 group-hover:text-emerald-500 transition-colors duration-200">{num}</span>
                    <span class="flex-grow font-medium text-slate-700 dark:text-slate-200 transition-transform duration-200 ease-out group-hover:translate-x-1 group-hover:text-slate-900 dark:group-hover:text-white">{text}</span>
                    <span class="text-slate-300 dark:text-slate-700 group-hover:text-emerald-500 transition-all duration-200 ease-out opacity-0 group-hover:opacity-100 group-hover:translate-x-1">&rarr;</span>
                  </a>
                );
              })}
            </div>
          </section>

          <!-- 客户端专区 -->
          <section id="section-3" class="scroll-mt-32">
            <div class="flex items-center space-x-4 mb-8">
              <div class="w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-600 flex items-center justify-center font-bold text-lg">3</div>
              <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">客户端与 Clash 专区</h2>
            </div>
            <div class="bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden divide-y divide-slate-100 dark:divide-slate-800/60 shadow-sm">
              {clash.map((title) => {
                const num = title.substring(0, 2);
                const text = title.substring(3);
                return (
                  <a href={`/blog/clash-${num}/`} class="group flex items-center p-4 sm:p-5 transition-all duration-200 ease-out hover:bg-slate-50 dark:hover:bg-slate-900 focus-visible:outline-none focus-visible:bg-slate-50 dark:focus-visible:bg-slate-900">
                    <span class="w-10 font-mono text-sm font-semibold text-slate-400 group-hover:text-blue-500 transition-colors duration-200">{num}</span>
                    <span class="flex-grow font-medium text-slate-700 dark:text-slate-200 transition-transform duration-200 ease-out group-hover:translate-x-1 group-hover:text-slate-900 dark:group-hover:text-white">{text}</span>
                    <span class="text-slate-300 dark:text-slate-700 group-hover:text-blue-500 transition-all duration-200 ease-out opacity-0 group-hover:opacity-100 group-hover:translate-x-1">&rarr;</span>
                  </a>
                );
              })}
            </div>
          </section>
        
          <!-- 常用网络工具 -->
          <section id="section-4" class="scroll-mt-32">
            <div class="flex items-center space-x-4 mb-8">
              <div class="w-10 h-10 rounded-full bg-purple-100 dark:bg-purple-900/50 text-purple-600 flex items-center justify-center font-bold text-lg">4</div>
              <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">常用网络工具</h2>
            </div>
            <div class="bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden divide-y divide-slate-100 dark:divide-slate-800/60 shadow-sm">
              {tools.map((title) => {
                const num = title.substring(0, 2);
                const text = title.substring(3);
                return (
                  <a href={`/blog/tools-${num}/`} class="group flex items-center p-4 sm:p-5 transition-all duration-200 ease-out hover:bg-slate-50 dark:hover:bg-slate-900 focus-visible:outline-none focus-visible:bg-slate-50 dark:focus-visible:bg-slate-900">
                    <span class="w-10 font-mono text-sm font-semibold text-slate-400 group-hover:text-purple-500 transition-colors duration-200">{num}</span>
                    <span class="flex-grow font-medium text-slate-700 dark:text-slate-200 transition-transform duration-200 ease-out group-hover:translate-x-1 group-hover:text-slate-900 dark:group-hover:text-white">{text}</span>
                    <span class="text-slate-300 dark:text-slate-700 group-hover:text-purple-500 transition-all duration-200 ease-out opacity-0 group-hover:opacity-100 group-hover:translate-x-1">&rarr;</span>
                  </a>
                );
              })}
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
