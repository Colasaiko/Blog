---
export interface Props {
  level: 'official' | 'verified' | 'tested' | 'untested';
}

const { level } = Astro.props;

const badgeConfig = {
  official: {
    text: '官方资料',
    icon: '🏢',
    classes: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 border-blue-200 dark:border-blue-800',
  },
  verified: {
    text: '本站核验',
    icon: '🛡️',
    classes: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800',
  },
  tested: {
    text: '独立测试',
    icon: '🔬',
    classes: 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300 border-purple-200 dark:border-purple-800',
  },
  untested: {
    text: '未测试',
    icon: '⚠️',
    classes: 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 border-amber-200 dark:border-amber-800',
  }
};

const config = badgeConfig[level] || badgeConfig.untested;
---

<span class={`inline-flex items-center gap-1 px-1.5 py-0.5 mx-1 rounded-sm text-xs font-medium border ${config.classes} align-middle select-none whitespace-nowrap`}>
  <span class="text-[11px] leading-none">{config.icon}</span>
  <span>{config.text}</span>
</span>
