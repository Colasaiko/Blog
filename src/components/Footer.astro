---
const today = new Date();
---

<footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 mt-20 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 py-8 md:py-12">
    <div class="md:flex md:items-center md:justify-between text-sm text-slate-500 dark:text-slate-400">
      <div class="flex justify-center md:justify-start mb-6 md:mb-0 space-x-6 md:order-2">
        <a href="https://github.com/Colasaiko/Blog" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">
          <span class="sr-only">GitHub</span>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
        </a>
        
      </div>
      <div class="mt-8 md:mt-0 md:order-1 flex flex-col md:flex-row items-center space-y-4 md:space-y-0 md:space-x-8 text-center md:text-left">
        <div class="flex space-x-4">
          <a href="/about/" class="hover:text-slate-900 dark:hover:text-white transition-colors">关于</a>
          <a href="/resources/" class="hover:text-slate-900 dark:hover:text-white transition-colors">相关资源</a>
          <a href="/privacy/" class="hover:text-slate-900 dark:hover:text-white transition-colors">隐私</a>
          <a href="/disclaimer/" class="hover:text-slate-900 dark:hover:text-white transition-colors">免责声明</a>
        </div>
        <div>&copy; {today.getFullYear()} 好机场. 保留所有权利。</div>
      </div>
    </div>
  </div>
</footer>
