  ) : ['自制剧', '漫游', 'TRY', 'ARS'].some(k => node.steam.includes(k)) ? (
    <span class="inline-block px-1.5 py-0.5 bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-400 border border-amber-200 dark:border-amber-800/50 rounded-sm leading-none">{node.steam}</span>
  ) : (
    <span class="inline-block px-1.5 py-0.5 bg-slate-100 text-slate-600 dark:bg-slate-800/50 dark:text-slate-400 border border-slate-200 dark:border-slate-700/50 rounded-sm leading-none">{node.steam}</span>
  )}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Status Bar -->
