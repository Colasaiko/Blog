---
export interface Props {
  brand: string;
  testTime?: string;
}

const { brand, testTime = '2026-08-22 20:30' } = Astro.props;

// Seeded random
let seed = 0;
for (let i = 0; i < brand.length; i++) {
  seed += brand.charCodeAt(i);
}
seed += testTime.length + 42; // Add offset to differ from SpeedTestPanel

function random() {
  let x = Math.sin(seed++) * 10000;
  return x - Math.floor(x);
}

function randomRange(min: number, max: number) {
  return random() * (max - min) + min;
}

const regions = [
  { prefix: '香港', id: 'HK', count: Math.floor(randomRange(10, 15)), pingBase: 25, currency: 'HKD' },
  { prefix: '台湾', id: 'TW', count: Math.floor(randomRange(5, 8)), pingBase: 38, currency: 'TWD' },
  { prefix: '日本', id: 'JP', count: Math.floor(randomRange(8, 12)), pingBase: 60, currency: 'JPY' },
  { prefix: '新加坡', id: 'SG', count: Math.floor(randomRange(6, 10)), pingBase: 70, currency: 'SGD' },
  { prefix: '美国', id: 'US', count: Math.floor(randomRange(8, 12)), pingBase: 160, currency: 'USD' },
];

const types = ['Vless', 'Vless', 'Vless', 'Trojan', 'SS', 'AnyTLS'];

interface UnlockNodeData {
  index: number;
  id: number | string;
  name: string;
  type: string;
  tlsRtt: string;
  tlsNum: number;
  httpsPing: string;
  pingNum: number;
  yt: string;
  nf: string;
  dp: string;
  bili: string;
  tk: string;
  abema: string;
  dazn: string;
  baha: string;
  openai: string;
  steam: string;
  isError: boolean;
}

let nodes: UnlockNodeData[] = [];
let index = 1;
let totalNodes = 0;

regions.forEach(region => {
  for (let i = 1; i <= region.count; i++) {
    let isError = random() < 0.03; 
    let nodeName = `${region.prefix} 优化 ${String(i).padStart(2, '0')}`;
    if (random() < 0.2) nodeName = `${region.prefix} 专线 ${String(i).padStart(2, '0')}`;
    let type = types[Math.floor(random() * types.length)];
    
    let tlsRtt = 0;
    let httpsPing = 0;
    
    if (!isError) {
      tlsRtt = region.pingBase * randomRange(0.8, 1.3);
      httpsPing = tlsRtt + randomRange(10, 30);
    }
    
    // --- Unlocking Logic ---
    let yt = isError ? 'N/A' : (random() < 0.95 ? `解锁(${region.id})` : '失败');
    
    let nf = '失败';
    if (!isError) {
      let r = random();
      if (r < 0.7) nf = `解锁(${region.id})`;
      else if (r < 0.85) nf = '仅自制剧';
      else nf = '失败';
    }

    let dp = '失败';
    if (!isError) {
      if (region.id === 'HK' && random() < 0.5) dp = '失败';
      else if (random() < 0.9) dp = `解锁(${region.id})`;
    }

    let bili = '失败';
    if (!isError) {
      if (region.id === 'HK' || region.id === 'TW') bili = '解锁(港澳台)';
      else if (random() < 0.1) bili = '解锁(漫游)';
    }

    let tk = '失败';
    if (!isError) {
      if (region.id === 'HK') tk = (random() < 0.1 ? '解锁(HK)' : '失败');
      else tk = (random() < 0.9 ? `解锁(${region.id})` : '失败');
    }

    let dazn = '失败';
    if (!isError) {
      if (region.id !== 'HK' && region.id !== 'TW' && random() < 0.4) dazn = `解锁(${region.id})`;
    }

    let abema = '失败';
    if (!isError && region.id === 'JP' && random() < 0.8) abema = '解锁(JP)';

    let baha = '失败';
    if (!isError && region.id === 'TW' && random() < 0.9) baha = '解锁(TW)';
    if (!isError && region.id === 'HK' && random() < 0.2) baha = '解锁(TW)'; // DNS routed

    let openai = '失败';
    if (!isError) {
      if (region.id === 'HK') {
        openai = random() < 0.5 ? '解锁(SG)' : '送中/拒绝'; // Often DNS unlocked to SG/US
      } else {
        openai = random() < 0.95 ? `解锁(${region.id})` : '限制';
      }
    }

    let steam = isError ? 'N/A' : region.currency;
    if (!isError && random() < 0.03) steam = 'TRY'; // Fake proxy routing anomaly
    if (!isError && random() < 0.03) steam = 'ARS';

    totalNodes++;

    nodes.push({
      index: index,
      id: index++,
      name: nodeName,
      type: type,
      tlsRtt: isError ? 'Error' : tlsRtt.toFixed(0) + ' ms',
      tlsNum: tlsRtt,
      httpsPing: isError ? 'Timeout' : httpsPing.toFixed(0) + ' ms',
      pingNum: httpsPing,
      isError: isError,
      yt, nf, dp, bili, tk, dazn, abema, baha, openai, steam
    });
  }
});

// Ping color formatter
function getPingColor(ms: number, isError: boolean) {
  if (isError) return 'text-rose-500 font-bold';
  if (ms < 50) return 'text-emerald-500 dark:text-emerald-400 font-medium';
  if (ms < 120) return 'text-amber-500 dark:text-amber-400 font-medium';
  return 'text-slate-500 dark:text-slate-400';
}
