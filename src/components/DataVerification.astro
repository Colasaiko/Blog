---
import TrustBadge from './TrustBadge.astro';

export interface Props {
  lastVerified?: string;
  nodeCount?: string;
  onlineNodes?: string;
  offlineNodes?: string;
  regions?: string;
  price?: string;
  promoCode?: string;
  clientSupport?: string;
  speedTestStatus?: string;
}

const {
  lastVerified,
  nodeCount,
  onlineNodes,
  offlineNodes,
  regions,
  price,
  promoCode,
  clientSupport = '多平台通用',
  speedTestStatus
} = Astro.props;
---

<div class="my-10 bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden not-prose w-full">
  <div class="bg-slate-50 dark:bg-slate-800/80 px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex flex-wrap gap-4 justify-between items-center">
    <div class="flex items-center gap-3">
      <h3 class="text-base font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
        <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        核心数据展示
      </h3>
    </div>
    {lastVerified && (
      <div class="text-xs font-medium px-3 py-1 bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400 rounded-full border border-green-200 dark:border-green-800 flex items-center gap-1.5 shadow-sm">
        <div class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></div>
        最后核验: {lastVerified}
      </div>
    )}
  </div>
  
  <div class="p-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      
      {nodeCount && (
      <div class="flex flex-col gap-1 p-3 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">宣称节点数量</span>
        <span class="text-sm font-medium text-slate-900 dark:text-white flex items-center gap-2">
          {nodeCount}
        </span>
      </div>
      )}

      {regions && (
      <div class="flex flex-col gap-1 p-3 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">覆盖地区</span>
        <span class="text-sm font-medium text-slate-900 dark:text-white line-clamp-2" title={regions}>
          {regions}
        </span>
      </div>
      )}

      {price && price !== '未提供' && (
      <div class="flex flex-col gap-1 p-3 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">起步价格</span>
        <span class="text-sm font-bold text-primary-600 dark:text-primary-400">
          {price}
        </span>
      </div>
      )}

      {promoCode && promoCode !== '未提供' && (
      <div class="flex flex-col gap-1 p-3 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">优惠码</span>
        <span class="text-sm font-mono bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded text-slate-800 dark:text-slate-200 inline-block w-fit">
          {promoCode}
        </span>
      </div>
      )}

      {clientSupport && (
      <div class="flex flex-col gap-1 p-3 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">客户端支持</span>
        <span class="text-sm font-medium text-slate-900 dark:text-white">
          {clientSupport}
        </span>
      </div>
      )}

      {speedTestStatus && speedTestStatus !== '未提供' && (
      <div class="flex flex-col gap-1 p-3 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">独立测速状态</span>
        <span class="text-sm font-medium text-slate-900 dark:text-white">
          {speedTestStatus}
        </span>
      </div>
      )}

    </div>
  </div>
</div>