---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { text: '首页', href: '/' },
  { text: '推荐机场', href: '/brands/', highlight: true },
  { text: '新手教程', href: '/network/' },
  { text: '网络知识', href: '/blog/' },
  { text: 'AI', href: '/ai/' },
];
---

<header id="site-header" class="fixed top-0 z-50 w-full transition-all duration-300 ease-out bg-white/0 border-b border-transparent">
  <div class="max-w-7xl mx-auto">
    <div id="header-container" class="transition-all duration-300 ease-out py-5 lg:px-8 px-4 sm:px-6 md:px-8">
      <div class="relative flex items-center justify-between">
        <a href="/" class="flex-none font-bold text-xl tracking-tight text-slate-900 dark:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-md">
          <span class="text-primary-500">好</span>机场
        </a>
        
        <div class="relative hidden md:flex items-center ml-auto">
          <nav class="text-sm leading-6 font-semibold text-slate-700 dark:text-slate-200">
            <ul class="flex space-x-6 lg:space-x-8">
              {links.map((link) => (
                <li>
                  <a href={link.href} class="relative group px-1 py-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-md">
                    <span class={link.highlight ? "transition-colors duration-200 text-primary-500 dark:text-primary-400 font-extrabold drop-shadow-[0_0_8px_rgba(59,130,246,0.6)] dark:drop-shadow-[0_0_8px_rgba(96,165,250,0.6)] animate-pulse" : "transition-colors duration-200 group-hover:text-primary-600 dark:group-hover:text-primary-400"}>
                      {link.text}
                    </span>
                    <span class="absolute -bottom-1 left-1/2 w-0 h-0.5 bg-primary-500 group-hover:w-full group-hover:left-0 transition-all duration-200 ease-out rounded-full motion-reduce:transition-none"></span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="flex items-center border-l border-slate-200 dark:border-slate-800 ml-6 pl-6">
            <ThemeToggle />
            <a href="/chat/" title="AI 助手" class="ml-4 text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors p-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-md">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="flex md:hidden items-center">
          <ThemeToggle />
            <a href="/chat/" title="AI 助手" class="ml-4 text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors p-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-md">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
              </svg>
            </a>
          <button id="mobile-menu-btn" class="ml-4 text-slate-500 dark:text-slate-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-md p-1 transition-colors hover:text-primary-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
          </button>
        </div>
      </div>
    </div>
    
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 dark:border-slate-800 pb-4 px-4 sm:px-6 bg-white dark:bg-slate-950">
      <nav class="flex flex-col space-y-4 pt-4 text-sm font-semibold text-slate-700 dark:text-slate-200">
        {links.map((link) => (
          <a href={link.href} class={`block transition-colors p-2 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 ${link.highlight ? 'text-primary-600 dark:text-primary-400 font-extrabold bg-primary-50 dark:bg-primary-900/30 drop-shadow-[0_0_5px_rgba(59,130,246,0.5)] animate-pulse' : 'hover:text-primary-600 dark:hover:text-primary-400 hover:bg-slate-50 dark:hover:bg-slate-900'}`}>
            {link.text}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Header scroll interaction
  const header = document.getElementById('site-header');
  const headerContainer = document.getElementById('header-container');
  
  const handleScroll = () => {
    if (window.scrollY > 20) {
      header?.classList.add('bg-white/80', 'dark:bg-slate-950/80', 'backdrop-blur-md', 'border-slate-200', 'dark:border-slate-800', 'shadow-sm');
      header?.classList.remove('bg-white/0', 'border-transparent');
      headerContainer?.classList.remove('py-5');
      headerContainer?.classList.add('py-3');
    } else {
      header?.classList.remove('bg-white/80', 'dark:bg-slate-950/80', 'backdrop-blur-md', 'border-slate-200', 'dark:border-slate-800', 'shadow-sm');
      header?.classList.add('bg-white/0', 'border-transparent');
      headerContainer?.classList.remove('py-3');
      headerContainer?.classList.add('py-5');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll(); // init on load
</script>
